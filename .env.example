# ──────────────────────────────────────────────
#  Codebot — Environment Variables
#  Copy this file:  cp .env.example .env
#  Then fill in your real keys below.
# ──────────────────────────────────────────────

# ── LLM API Keys (required) ──────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── LangSmith Tracing (optional) ─────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-key-here
LANGCHAIN_PROJECT=codebot

# ── Database ──────────────────────────────────
# Docker Compose overrides this automatically.
# Only set manually if using an external database.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost/codebot

# ── Auth / JWT ────────────────────────────────
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
GUEST_SESSION_EXPIRES_SECONDS=259200
GUEST_MESSAGE_LIMIT=20

# ── Cookie Settings ──────────────────────────
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ── Google OAuth (optional) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── URLs ─────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PORT=8000

# ── Schema ───────────────────────────────────
# Docker Compose sets AUTO_CREATE_SCHEMA=true automatically.
AUTO_CREATE_SCHEMA=false
AUTO_MIGRATE_LEGACY_AUTH_SCHEMA=true
